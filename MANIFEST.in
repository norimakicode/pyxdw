include LICENSE NOTICE README.md README.ja.md AGENTS.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py
prune publication
prune testdata
prune build
prune dist
prune .venv
prune venv
global-exclude __pycache__ *.py[cod] .DS_Store .env .env.* *.xdw *.xbd *.dll *.exe
